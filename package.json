{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server.cjs",
    "cms": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "node --max-old-space-size=512 ./node_modules/vite/bin/vite.js build",
    "start": "npm run build && node server.cjs",
    "native:rebuild": "npm rebuild better-sqlite3",
    "lint": "oxlint",
    "check": "npm run lint && tsc -b --pretty false && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "dompurify": "^3.4.18",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.77.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-router-dom": "^7.18.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0"
  }
}
